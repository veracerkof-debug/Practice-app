<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher_meletiy"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_meletiy_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- Значок в списке приложений — у activity-ярлыков ниже (иконка на выбор, IconPlugin.java) -->

            <!-- Файл .melete от команды (песни, сет-лист): открыть из Telegram, почты, файлового менеджера (src/core/share.js) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-melete" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-melete" />
            </intent-filter>

        </activity>

        <!-- Иконка приложения на выбор («Оформление», src/ui/appicons.js): у каждой — своя маленькая activity-ярлык
             (IconActivities.java), включена ровно одна; она сразу открывает MainActivity. Не activity-alias: некоторые
             установщики отвергают пакет, где значок запуска есть только у alias -->
        <activity
            android:name=".IconMelete"
            android:enabled="false"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_melete"
            android:roundIcon="@mipmap/ic_launcher_melete_round"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".IconMeletiy"
            android:enabled="true"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_meletiy"
            android:roundIcon="@mipmap/ic_launcher_meletiy_round"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".IconNote"
            android:enabled="false"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_note"
            android:roundIcon="@mipmap/ic_launcher_note_round"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".IconClef"
            android:enabled="false"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_clef"
            android:roundIcon="@mipmap/ic_launcher_clef_round"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".IconFork"
            android:enabled="false"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_fork"
            android:roundIcon="@mipmap/ic_launcher_fork_round"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".IconKeys"
            android:enabled="false"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_keys"
            android:roundIcon="@mipmap/ic_launcher_keys_round"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".IconClassic"
            android:enabled="false"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Работа в фоне (KeepAliveService): пока идёт занятие или звучит инструмент -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Микрофон: тюнер, спектр и шумомер. Звук обрабатывается только на устройстве -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Вибрация в такт метронома -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Работа в фоне: пока идёт занятие или звучит инструмент — служба с тихим уведомлением, процессор не засыпает;
         снятие ограничения батареи — только по согласию человека (системный запрос) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Фонарик: только наличие вспышки -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <!-- Камера: только терменвокс (руки перед камерой), кадры обрабатываются на устройстве и не сохраняются.
         Разрешение спрашивается при включении камеры в терменвоксе; без камеры приложение ставится и работает -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
</manifest>
