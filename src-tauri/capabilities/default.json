{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Главное окно: диалоги выбора, папка Melete и файлы, которые выбрал человек; свои команды — разрешение папки и файлы при запуске",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-allow-dir",
    "allow-startup-files",
    "allow-stems-begin",
    "allow-stems-push",
    "allow-stems-run",
    "allow-stems-read",
    "allow-stems-cancel",
    "allow-stems-clean",
    "allow-lyrics-supported",
    "allow-lyrics-begin",
    "allow-lyrics-push",
    "allow-lyrics-run",
    "allow-lyrics-cancel",
    "allow-lyrics-clean",
    "allow-localsend-start",
    "allow-localsend-stop",
    "allow-localsend-status",
    "allow-localsend-answer",
    "allow-denoise-begin",
    "allow-denoise-push",
    "allow-denoise-run",
    "allow-denoise-read",
    "allow-denoise-cancel",
    "allow-denoise-clean",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-stat",
    "fs:allow-lstat",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-seek",
    "fs:allow-fstat",
    "fs:allow-truncate",
    "fs:allow-ftruncate",
    "fs:allow-size",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DESKTOP/**"
        }
      ]
    }
  ]
}
