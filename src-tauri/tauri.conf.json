{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melete",
  "version": "1.2.0",
  "identifier": "app.melete",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Melete",
        "label": "main",
        "width": 1180,
        "height": 800,
        "minWidth": 420,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "models/whisper/": "models/whisper/",
      "models/roformer/": "models/roformer/",
      "models/ymt/": "models/ymt/"
    },
    "category": "Music",
    "shortDescription": "Melete — практика музыкантов",
    "longDescription": "Учёт занятий и статистика, метроном, тюнер, пианино, лупер, студия, табы и ноты. Без рекламы и трекинга.",
    "publisher": "Melete",
    "copyright": "GPL-3.0",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "melete"
        ],
        "name": "Melete",
        "description": "Файл Melete: песни, табы, сет-лист",
        "role": "Editor"
      },
      {
        "ext": [
          "gp",
          "gp3",
          "gp4",
          "gp5",
          "gpx"
        ],
        "name": "Guitar Pro",
        "description": "Табулатура Guitar Pro",
        "role": "Viewer"
      },
      {
        "ext": [
          "musicxml",
          "mxl"
        ],
        "name": "MusicXML",
        "description": "Ноты MusicXML",
        "role": "Viewer"
      },
      {
        "ext": [
          "mid",
          "midi"
        ],
        "name": "MIDI",
        "description": "Файл MIDI",
        "role": "Viewer"
      },
      {
        "ext": [
          "flp",
          "als",
          "rpp"
        ],
        "name": "DAW project",
        "description": "Проект студии (FL Studio, Ableton Live, Reaper)",
        "role": "Viewer"
      }
    ]
  }
}
